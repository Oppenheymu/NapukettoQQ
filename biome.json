{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**/src/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}",
            "**/loader/runtime/**",
            "**/loader/scripts/**"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnresolvedImports": "off"
            },
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "conventions": [
                            {
                                "selector": {
                                    "kind": "typeParameter"
                                },
                                "formats": ["PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "typeMember"
                                },
                                "formats": ["camelCase", "snake_case", "PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "objectLiteralMember"
                                },
                                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
                            }
                        ]
                    }
                }
            },
            "nursery": {
                "noFloatingPromises": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "packages/kernel/src/apis/webapi.ts",
                "packages/kernel/src/apis/ticket.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useNamingConvention": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
