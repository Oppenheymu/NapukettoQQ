{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "all",
            "correctness": {
                "noNodejsModules": "off",
                "useImportExtensions": "off",
                "useQwikValidLexicalScope": "off",
                "noUnusedVariables": "error",
                "noUnusedFunctionParameters": "error",
                "noUnusedImports": "error",
                "noUnusedPrivateClassMembers": "error"
            },
            "performance": {
                "noBarrelFile": "off"
            },
            "complexity": {
                "useLiteralKeys": "off"
            },
            "suspicious": {
                "noExplicitAny": "error",
                "noImplicitAnyLet": "error",
                "noFallthroughSwitchClause": "error"
            },
            "style": {
                "useImportType": "error",
                "useExportType": "error",
                "noProcessEnv": "off",
                "useErrorCause": "off",
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false
                    }
                }
            },
            "security": {
                "noSecrets": "off"
            },
            "nursery": {
                "preset": "all",
                "noFloatingPromises": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
