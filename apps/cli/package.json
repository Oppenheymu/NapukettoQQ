{
    "name": "@napuketto/cli",
    "version": "0.1.11",
    "description": "Command line interface for NapukettoQQ",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "bin": {
        "napuketto": "./dist/index.mjs"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "start": "node ./dist/index.mjs"
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.6",
        "tsdown": "^0.22.14"
    },
    "license": "MIT",
    "dependencies": {
        "@napuketto/kernel": "^0.0.15",
        "@napuketto/network": "^0.0.2",
        "@napuketto/adapter": "^0.0.20",
        "@napuketto/loader": "^0.0.27",
        "commander": "^15.0.0",
        "qrcode": "^1.5.4"
    }
}
