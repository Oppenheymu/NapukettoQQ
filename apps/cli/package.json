{
    "name": "@napuketto/cli",
    "version": "0.0.1",
    "description": "Command line interface for NapukettoQQ",
    "private": true,
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "bin": {
        "napuketto": "./dist/index.js"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "start": "node ./dist/index.js"
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.6",
        "tsdown": "^0.22.14"
    },
    "license": "ISC",
    "dependencies": {
        "@napuketto/kernel": "workspace:*",
        "@napuketto/network": "workspace:*",
        "@napuketto/adapter": "workspace:*",
        "commander": "^15.0.0",
        "picocolors": "^1.1.1",
        "qrcode": "^1.5.4"
    }
}
