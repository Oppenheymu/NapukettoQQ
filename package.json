{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "NapukettoQQ",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "prepare": "pnpm -r build",
        "check": "biome check . && tsc --noEmit",
        "fix": "biome check --write . && tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "build": "pnpm -r build",
        "start": "node apps/cli/dist/index.mjs",
        "dev": "node apps/cli/dist/index.mjs",
        "config": "node apps/cli/dist/index.mjs config",
        "release": "pnpm -r build && pnpm -r publish --access public",
        "release:dryrun": "pnpm -r build && pnpm -r publish --access public --dry-run",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "睦 <oppenheymu@gmail.com>",
    "license": "MIT",
    "private": true,
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.6.0",
            "onFail": "download"
        }
    },
    "type": "module",
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/node": "^26.1.2",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
