{
    "name": "@napuketto/loader",
    "version": "0.0.1",
    "description": "NapukettoQQ 引导组件：拉起 QQ.exe 并注入 hook DLL，把业务代码带进 QQ 定制版 Electron 主进程",
    "type": "module",
    "private": true,
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown && node scripts/build-native.mjs"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsdown": "^0.22.14"
    },
    "license": "MIT"
}