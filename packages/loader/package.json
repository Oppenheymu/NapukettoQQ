{
    "name": "@napuketto/loader",
    "version": "0.0.9",
    "description": "NapukettoQQ 引导组件：自建宿主（标准 Node + stub QQNT.dll）dlopen wrapper.node 并启动 kernel，不拉起 QQ / 不注入",
    "type": "module",
    "files": [
        "dist",
        "native/build/stub-test-env",
        "qq-releases.json",
        "assets/7zip"
    ],
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsdown": "^0.22.14"
    },
    "license": "MIT"
}
