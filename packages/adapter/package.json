{
    "name": "@napuketto/adapter",
    "version": "0.0.1",
    "description": "Protocol adapters (OneBot11 / Satori) for NapukettoQQ",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./core": {
            "types": "./dist/core/index.d.mts",
            "import": "./dist/core/index.mjs"
        },
        "./onebot11": {
            "types": "./dist/onebot11/index.d.mts",
            "import": "./dist/onebot11/index.mjs"
        }
    },
    "tsdown": {
        "entry": [
            "src/index.ts",
            "src/core/index.ts",
            "src/onebot11/index.ts"
        ]
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "tsdown": "^0.22.14"
    },
    "license": "MIT",
    "dependencies": {
        "@napuketto/kernel": "workspace:*",
        "@napuketto/media": "workspace:*",
        "@napuketto/network": "workspace:*",
        "fast-xml-parser": "^5.10.1",
        "zod": "^4.4.3"
    }
}