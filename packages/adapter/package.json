{
    "name": "@napuketto/adapter",
    "version": "0.0.1",
    "description": "Protocol adapters (OneBot11 / OneBot12 / Satori) for NapukettoQQ",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown"
    },
    "devDependencies": {
        "tsdown": "^0.22.14"
    },
    "license": "GPL-3.0",
    "dependencies": {
        "@napuketto/kernel": "workspace:*",
        "@napuketto/media": "workspace:*",
        "@napuketto/network": "workspace:*",
        "fast-xml-parser": "^5.10.1",
        "zod": "^4.4.3"
    }
}